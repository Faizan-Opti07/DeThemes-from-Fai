  "semanticTokenColors": {
    "function": {
      "foreground": "#2563EB",
      "bold": true
    },
    "method": {
      "foreground": "#1D4ED8",
      "bold": true
    },
    "variable": {
      "foreground": "#0F766E",
      "bold": true
    },
    "variable.local": {
      "foreground": "#0F766E",
      "bold": true
    },
    "variable.readonly": {
      "foreground": "#B45309",
      "bold": true
    },
    "variable.defaultLibrary": {
      "foreground": "#2563EB",
      "bold": true
    },
    "parameter": {
      "foreground": "#B45309",
      "bold": true
    },
    "property": {
      "foreground": "#2563EB",
      "bold": true
    },
    "property.readonly": {
      "foreground": "#2563EB",
      "bold": true
    },
    "type": {
      "foreground": "#6B21A8",
      "bold": true
    },
    "class": {
      "foreground": "#6B21A8",
      "bold": true
    },
    "interface": {
      "foreground": "#6B21A8",
      "bold": true
    },
    "enum": {
      "foreground": "#6B21A8",
      "bold": true
    },
    "enumMember": {
      "foreground": "#C2410C",
      "bold": true
    },
    "keyword": {
      "foreground": "#1E3A8A",
      "bold": true
    },
    "number": {
      "foreground": "#C2410C",
      "bold": true
    },
    "string": {
      "foreground": "#166534"
    },
    "operator": {
      "foreground": "#DC2626",
      "bold": true
    },
    "macro": {
      "foreground": "#0F766E",
      "bold": true
    },
    "namespace": {
      "foreground": "#2563EB",
      "bold": true
    },
    "comment": {
      "foreground": "#475569",
      "italic": true
    }
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#475569",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Docstrings & JSDoc",
      "scope": [
        "comment.block.documentation",
        "storage.type.class.jsdoc",
        "variable.other.jsdoc"
      ],
      "settings": {
        "foreground": "#0F766E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Control Flow",
      "scope": [
        "keyword.control",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.flow",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.trycatch",
        "keyword.control.directive",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#1E3A8A",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Storage & Modifiers",
      "scope": [
        "storage.type",
        "storage.modifier",
        "keyword.declaration",
        "keyword.control.default"
      ],
      "settings": {
        "foreground": "#7C3AED",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Primitive Types (int, string, bool, void, double, char, etc.)",
      "scope": [
        "storage.type.primitive",
        "storage.type.numeric",
        "storage.type.built-in",
        "storage.type.cs",
        "storage.type.c",
        "storage.type.cpp",
        "keyword.type"
      ],
      "settings": {
        "foreground": "#9F1239",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Types, Classes, Structs, Enums",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.type.class",
        "entity.name.type.interface",
        "entity.name.type.struct",
        "entity.name.type.enum",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#6B21A8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function Definitions & Calls",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#2563EB",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Methods",
      "scope": [
        "entity.name.function.member",
        "meta.method-call entity.name.function",
        "support.function.misc"
      ],
      "settings": {
        "foreground": "#1D4ED8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "meta.function.parameters variable",
        "entity.name.variable.parameter"
      ],
      "settings": {
        "foreground": "#B45309",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Local & Global Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.local",
        "variable.other.cpp",
        "variable.other.local.cpp",
        "variable.other.readwrite.cpp"
      ],
      "settings": {
        "foreground": "#0F766E",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Constants & Readonly Variables",
      "scope": [
        "variable.other.constant",
        "constant.language",
        "constant.other"
      ],
      "settings": {
        "foreground": "#B45309",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Properties & Object Keys",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#2563EB",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Strings & Character Literals",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.single",
        "string.quoted.double",
        "string.template"
      ],
      "settings": {
        "foreground": "#166534"
      }
    },
    {
      "name": "Template Literal Expressions",
      "scope": [
        "punctuation.definition.template-expression",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#DC2626",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float",
        "constant.numeric.hex"
      ],
      "settings": {
        "foreground": "#C2410C",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Booleans, Null, Undefined",
      "scope": [
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#B45309",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.arithmetic",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.bitwise",
        "keyword.operator.increment-decrement",
        "keyword.operator.ternary",
        "keyword.operator.bitwise.shift"
      ],
      "settings": {
        "foreground": "#DC2626",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Punctuation & Delimiters",
      "scope": [
        "punctuation.terminator",
        "punctuation.separator",
        "punctuation.delimiter",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#1E293B"
      }
    },
    {
      "name": "Preprocessors & Includes (C/C++)",
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive.include",
        "string.quoted.other.lt-gt.include",
        "entity.name.function.preprocessor"
      ],
      "settings": {
        "foreground": "#0F766E",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Standard Library / Namespaces (std, cout, cin, console, Math)",
      "scope": [
        "entity.name.namespace",
        "support.class.builtin",
        "support.constant",
        "variable.language"
      ],
      "settings": {
        "foreground": "#2563EB",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tags (HTML/JSX)",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#6B21A8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Attributes (HTML/JSX)",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#B45309",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Invalid / Errors",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#DC2626"
      }
    }
  ]
}