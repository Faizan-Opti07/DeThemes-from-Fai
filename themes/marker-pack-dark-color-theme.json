  "semanticTokenColors": {
    "function": {
      "foreground": "#38BDF8",
      "bold": true
    },
    "method": {
      "bold": true
    },
    "variable": {
      "foreground": "#C084FC",
      "bold": true
    },
    "variable.local": {
      "foreground": "#C084FC",
      "bold": true
    },
    "variable.readonly": {
      "foreground": "#FDE047",
      "bold": true
    },
    "variable.defaultLibrary": {
      "foreground": "#38BDF8",
      "bold": true
    },
    "parameter": {
      "foreground": "#FB923C",
      "bold": true
    },
    "property": {
      "foreground": "#C084FC",
      "bold": true
    },
    "property.readonly": {
      "foreground": "#C084FC",
      "bold": true
    },
    "type": {
      "foreground": "#F472B6",
      "bold": true
    },
    "class": {
      "foreground": "#F472B6",
      "bold": true
    },
    "interface": {
      "foreground": "#F472B6",
      "bold": true
    },
    "enum": {
      "foreground": "#F472B6",
      "bold": true
    },
    "enumMember": {
      "foreground": "#FB923C",
      "bold": true
    },
    "keyword": {
      "foreground": "#FACC15",
      "bold": true
    },
    "number": {
      "foreground": "#FB923C",
      "bold": true
    },
    "string": {
      "foreground": "#4ADE80"
    },
    "operator": {
      "foreground": "#F87171",
      "bold": true
    },
    "macro": {
      "foreground": "#F472B6",
      "bold": true
    },
    "namespace": {
      "foreground": "#38BDF8",
      "bold": true
    },
    "comment": {
      "foreground": "#9CA3AF",
      "italic": true
    }
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9CA3AF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Docstrings & JSDoc",
      "scope": [
        "comment.block.documentation",
        "storage.type.class.jsdoc",
        "variable.other.jsdoc"
      ],
      "settings": {
        "foreground": "#F472B6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Control Flow",
      "scope": [
        "keyword.control",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.flow",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.trycatch",
        "keyword.control.directive",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#FACC15",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Storage & Modifiers",
      "scope": [
        "storage.type",
        "storage.modifier",
        "keyword.declaration",
        "keyword.control.default"
      ],
      "settings": {
        "foreground": "#F43F5E",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Primitive Types (int, string, bool, void, double, char, etc.)",
      "scope": [
        "storage.type.primitive",
        "storage.type.numeric",
        "storage.type.built-in",
        "storage.type.cs",
        "storage.type.c",
        "storage.type.cpp",
        "keyword.type"
      ],
      "settings": {
        "foreground": "#E879F9",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Types, Classes, Structs, Enums",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.type.class",
        "entity.name.type.interface",
        "entity.name.type.struct",
        "entity.name.type.enum",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#F472B6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function Definitions & Calls",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#38BDF8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Methods",
      "scope": [
        "entity.name.function.member",
        "meta.method-call entity.name.function",
        "support.function.misc"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "meta.function.parameters variable",
        "entity.name.variable.parameter"
      ],
      "settings": {
        "foreground": "#FB923C",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Local & Global Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.local",
        "variable.other.cpp",
        "variable.other.local.cpp",
        "variable.other.readwrite.cpp"
      ],
      "settings": {
        "foreground": "#C084FC",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Constants & Readonly Variables",
      "scope": [
        "variable.other.constant",
        "constant.language",
        "constant.other"
      ],
      "settings": {
        "foreground": "#FDE047",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Properties & Object Keys",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#C084FC",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Strings & Character Literals",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.single",
        "string.quoted.double",
        "string.template"
      ],
      "settings": {
        "foreground": "#4ADE80"
      }
    },
    {
      "name": "Template Literal Expressions",
      "scope": [
        "punctuation.definition.template-expression",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#F87171",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float",
        "constant.numeric.hex"
      ],
      "settings": {
        "foreground": "#FB923C",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Booleans, Null, Undefined",
      "scope": [
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#FDE047",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.arithmetic",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.bitwise",
        "keyword.operator.increment-decrement",
        "keyword.operator.ternary",
        "keyword.operator.bitwise.shift"
      ],
      "settings": {
        "foreground": "#F87171",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Punctuation & Delimiters",
      "scope": [
        "punctuation.terminator",
        "punctuation.separator",
        "punctuation.delimiter",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#F3F4F6"
      }
    },
    {
      "name": "Preprocessors & Includes (C/C++)",
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive.include",
        "string.quoted.other.lt-gt.include",
        "entity.name.function.preprocessor"
      ],
      "settings": {
        "foreground": "#F472B6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Standard Library / Namespaces (std, cout, cin, console, Math)",
      "scope": [
        "entity.name.namespace",
        "support.class.builtin",
        "support.constant",
        "variable.language"
      ],
      "settings": {
        "foreground": "#38BDF8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tags (HTML/JSX)",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#F472B6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Attributes (HTML/JSX)",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#FB923C",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Invalid / Errors",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#DC2626"
      }
    }
  ]
}