  "semanticTokenColors": {
    "function": {
      "foreground": "#22D3EE",
      "bold": true
    },
    "method": {
      "bold": true
    },
    "variable": {
      "foreground": "#4ADE80",
      "bold": true
    },
    "variable.local": {
      "foreground": "#4ADE80",
      "bold": true
    },
    "variable.readonly": {
      "foreground": "#FCD34D",
      "bold": true
    },
    "variable.defaultLibrary": {
      "foreground": "#22D3EE",
      "bold": true
    },
    "parameter": {
      "foreground": "#FBBF24",
      "bold": true
    },
    "property": {
      "foreground": "#38BDF8",
      "bold": true
    },
    "property.readonly": {
      "foreground": "#38BDF8",
      "bold": true
    },
    "type": {
      "foreground": "#A78BFA",
      "bold": true
    },
    "class": {
      "foreground": "#A78BFA",
      "bold": true
    },
    "interface": {
      "foreground": "#A78BFA",
      "bold": true
    },
    "enum": {
      "foreground": "#A78BFA",
      "bold": true
    },
    "enumMember": {
      "foreground": "#FB923C",
      "bold": true
    },
    "keyword": {
      "foreground": "#2DD4BF",
      "bold": true
    },
    "number": {
      "foreground": "#FB923C",
      "bold": true
    },
    "string": {
      "foreground": "#86EFAC"
    },
    "operator": {
      "foreground": "#F87171",
      "bold": true
    },
    "macro": {
      "foreground": "#2DD4BF",
      "bold": true
    },
    "namespace": {
      "foreground": "#22D3EE",
      "bold": true
    },
    "comment": {
      "foreground": "#6EE7B7",
      "italic": true
    }
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6EE7B7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Docstrings & JSDoc",
      "scope": [
        "comment.block.documentation",
        "storage.type.class.jsdoc",
        "variable.other.jsdoc"
      ],
      "settings": {
        "foreground": "#2DD4BF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Control Flow",
      "scope": [
        "keyword.control",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.flow",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.trycatch",
        "keyword.control.directive",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#2DD4BF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Storage & Modifiers",
      "scope": [
        "storage.type",
        "storage.modifier",
        "keyword.declaration",
        "keyword.control.default"
      ],
      "settings": {
        "foreground": "#C084FC",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Primitive Types (int, string, bool, void, double, char, etc.)",
      "scope": [
        "storage.type.primitive",
        "storage.type.numeric",
        "storage.type.built-in",
        "storage.type.cs",
        "storage.type.c",
        "storage.type.cpp",
        "keyword.type"
      ],
      "settings": {
        "foreground": "#FB7185",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Types, Classes, Structs, Enums",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.type.class",
        "entity.name.type.interface",
        "entity.name.type.struct",
        "entity.name.type.enum",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#A78BFA",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function Definitions & Calls",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#22D3EE",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Methods",
      "scope": [
        "entity.name.function.member",
        "meta.method-call entity.name.function",
        "support.function.misc"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "meta.function.parameters variable",
        "entity.name.variable.parameter"
      ],
      "settings": {
        "foreground": "#FBBF24",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Local & Global Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.local",
        "variable.other.cpp",
        "variable.other.local.cpp",
        "variable.other.readwrite.cpp"
      ],
      "settings": {
        "foreground": "#4ADE80",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Constants & Readonly Variables",
      "scope": [
        "variable.other.constant",
        "constant.language",
        "constant.other"
      ],
      "settings": {
        "foreground": "#FCD34D",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Properties & Object Keys",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#38BDF8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Strings & Character Literals",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.single",
        "string.quoted.double",
        "string.template"
      ],
      "settings": {
        "foreground": "#86EFAC"
      }
    },
    {
      "name": "Template Literal Expressions",
      "scope": [
        "punctuation.definition.template-expression",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#F87171",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float",
        "constant.numeric.hex"
      ],
      "settings": {
        "foreground": "#FB923C",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Booleans, Null, Undefined",
      "scope": [
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#FCD34D",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.arithmetic",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.bitwise",
        "keyword.operator.increment-decrement",
        "keyword.operator.ternary",
        "keyword.operator.bitwise.shift"
      ],
      "settings": {
        "foreground": "#F87171",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Punctuation & Delimiters",
      "scope": [
        "punctuation.terminator",
        "punctuation.separator",
        "punctuation.delimiter",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#94A3B8"
      }
    },
    {
      "name": "Preprocessors & Includes (C/C++)",
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive.include",
        "string.quoted.other.lt-gt.include",
        "entity.name.function.preprocessor"
      ],
      "settings": {
        "foreground": "#2DD4BF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Standard Library / Namespaces (std, cout, cin, console, Math)",
      "scope": [
        "entity.name.namespace",
        "support.class.builtin",
        "support.constant",
        "variable.language"
      ],
      "settings": {
        "foreground": "#22D3EE",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tags (HTML/JSX)",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#A78BFA",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Attributes (HTML/JSX)",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#FBBF24",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Invalid / Errors",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#DC2626"
      }
    }
  ]
}