  "semanticTokenColors": {
    "function": {
      "foreground": "#0284C7",
      "bold": true
    },
    "method": {
      "foreground": "#0369A1",
      "bold": true
    },
    "variable": {
      "foreground": "#15803D",
      "bold": true
    },
    "variable.local": {
      "foreground": "#15803D",
      "bold": true
    },
    "variable.readonly": {
      "foreground": "#D97706",
      "bold": true
    },
    "variable.defaultLibrary": {
      "foreground": "#0284C7",
      "bold": true
    },
    "parameter": {
      "foreground": "#EA580C",
      "bold": true
    },
    "property": {
      "foreground": "#7C3AED",
      "bold": true
    },
    "property.readonly": {
      "foreground": "#7C3AED",
      "bold": true
    },
    "type": {
      "foreground": "#7C3AED",
      "bold": true
    },
    "class": {
      "foreground": "#7C3AED",
      "bold": true
    },
    "interface": {
      "foreground": "#7C3AED",
      "bold": true
    },
    "enum": {
      "foreground": "#7C3AED",
      "bold": true
    },
    "enumMember": {
      "foreground": "#C2410C",
      "bold": true
    },
    "keyword": {
      "foreground": "#3730A3",
      "bold": true
    },
    "number": {
      "foreground": "#C2410C",
      "bold": true
    },
    "string": {
      "foreground": "#059669"
    },
    "operator": {
      "foreground": "#E11D48",
      "bold": true
    },
    "macro": {
      "foreground": "#BE185D",
      "bold": true
    },
    "namespace": {
      "foreground": "#0284C7",
      "bold": true
    },
    "comment": {
      "foreground": "#64748B",
      "italic": true
    }
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#64748B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Docstrings & JSDoc",
      "scope": [
        "comment.block.documentation",
        "storage.type.class.jsdoc",
        "variable.other.jsdoc"
      ],
      "settings": {
        "foreground": "#BE185D",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords & Control Flow",
      "scope": [
        "keyword.control",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.flow",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.trycatch",
        "keyword.control.directive",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#3730A3",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Storage & Modifiers",
      "scope": [
        "storage.type",
        "storage.modifier",
        "keyword.declaration",
        "keyword.control.default"
      ],
      "settings": {
        "foreground": "#86198F",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Primitive Types (int, string, bool, void, double, char, etc.)",
      "scope": [
        "storage.type.primitive",
        "storage.type.numeric",
        "storage.type.built-in",
        "storage.type.cs",
        "storage.type.c",
        "storage.type.cpp",
        "keyword.type"
      ],
      "settings": {
        "foreground": "#BE185D",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Types, Classes, Structs, Enums",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.type.class",
        "entity.name.type.interface",
        "entity.name.type.struct",
        "entity.name.type.enum",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#7C3AED",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function Definitions & Calls",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call entity.name.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#0284C7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Methods",
      "scope": [
        "entity.name.function.member",
        "meta.method-call entity.name.function",
        "support.function.misc"
      ],
      "settings": {
        "foreground": "#0369A1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "meta.function.parameters variable",
        "entity.name.variable.parameter"
      ],
      "settings": {
        "foreground": "#EA580C",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Local & Global Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.local",
        "variable.other.cpp",
        "variable.other.local.cpp",
        "variable.other.readwrite.cpp"
      ],
      "settings": {
        "foreground": "#15803D",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Constants & Readonly Variables",
      "scope": [
        "variable.other.constant",
        "constant.language",
        "constant.other"
      ],
      "settings": {
        "foreground": "#D97706",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Properties & Object Keys",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#7C3AED",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Strings & Character Literals",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.single",
        "string.quoted.double",
        "string.template"
      ],
      "settings": {
        "foreground": "#059669"
      }
    },
    {
      "name": "Template Literal Expressions",
      "scope": [
        "punctuation.definition.template-expression",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#E11D48",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float",
        "constant.numeric.hex"
      ],
      "settings": {
        "foreground": "#C2410C",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Booleans, Null, Undefined",
      "scope": [
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#D97706",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.arithmetic",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.bitwise",
        "keyword.operator.increment-decrement",
        "keyword.operator.ternary",
        "keyword.operator.bitwise.shift"
      ],
      "settings": {
        "foreground": "#E11D48",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Punctuation & Delimiters",
      "scope": [
        "punctuation.terminator",
        "punctuation.separator",
        "punctuation.delimiter",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#475569"
      }
    },
    {
      "name": "Preprocessors & Includes (C/C++)",
      "scope": [
        "meta.preprocessor",
        "keyword.control.directive.include",
        "string.quoted.other.lt-gt.include",
        "entity.name.function.preprocessor"
      ],
      "settings": {
        "foreground": "#BE185D",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Standard Library / Namespaces (std, cout, cin, console, Math)",
      "scope": [
        "entity.name.namespace",
        "support.class.builtin",
        "support.constant",
        "variable.language"
      ],
      "settings": {
        "foreground": "#0284C7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tags (HTML/JSX)",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#7C3AED",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Attributes (HTML/JSX)",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#EA580C",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Invalid / Errors",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "background": "#DC2626"
      }
    }
  ]
}